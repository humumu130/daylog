{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "今日",
  "version": "0.1.0",
  "identifier": "com.worklog.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "今日",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      },
      {
        "label": "quick-capture",
        "url": "index.html",
        "width": 460,
        "height": 340,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "widget",
        "url": "index.html",
        "width": 320,
        "height": 480,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
